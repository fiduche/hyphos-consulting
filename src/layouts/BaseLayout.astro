---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PreviewBar from '../components/PreviewBar.astro';

interface Props {
  title: string;
  description?: string;
  /** Hide the marketing header/footer chrome (rare — used by form-only pages). */
  minimal?: boolean;
  /** Keep the page out of search results. Travels in the HTML, so it survives
   *  edge caching in a way a response header set by the worker does not. */
  noindex?: boolean;
}

const {
  title,
  description = 'Hyphos helps growing businesses handle more revenue with the people they already have by connecting company information with usable organizational knowledge.',
  minimal = false,
  noindex = false,
} = Astro.props;

const fullTitle = title.startsWith('Hyphos') ? title : `${title} — Hyphos Inc.`;
const siteUrl = 'https://hyphosconsulting.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Hyphos" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Source+Serif+4:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <PreviewBar site="consulting" />
    {!minimal && <Header />}
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    {!minimal && <Footer />}
  </body>
</html>
