---
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Retired. The dinner now runs from one screen, /golf/prizes, which awards the
 * Hyphos and Tidal contest prizes alongside the full prize table. This page
 * only forwards, keeping ?demo=1, so an old bookmark on the presentation
 * laptop still lands on the right screen.
 */
---

<BaseLayout title="Prize draw" noindex minimal>
  <main style="max-width:32rem;margin:20vh auto;padding:0 20px;font-family:system-ui,sans-serif">
    <p>The dinner draw has moved. <a id="go" href="/golf/prizes">Open the prize draw</a>.</p>
  </main>
  <script>
    const to = '/golf/prizes' + location.search;
    document.getElementById('go')?.setAttribute('href', to);
    location.replace(to);
  </script>
</BaseLayout>
