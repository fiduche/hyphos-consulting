---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mark from '../../components/Mark.astro';

/**
 * The full prize draw for the tournament, run from the Hyphos laptop.
 *
 * The committee hands over the attendee list and the prize table; the
 * score-based winners are struck off first; then every remaining prize is
 * drawn one keypress at a time with the Hyphos frame around it the whole
 * way. Nothing here touches the network: the lists are pasted in on this
 * device, kept in localStorage so a reload mid-evening loses nothing, and the
 * winners come out as a CSV for the organisers at the end.
 *
 * This is the one dinner screen. Most prizes are drawn from everyone in the
 * hat, but three follow the rules they were advertised with, and a tag on the
 * prize line says which:
 *
 *   Dozen Pro V1s | Hyphos Inc. | best answer   judged at /golf/judge; the
 *                                               answer is read out first, then
 *                                               the name
 *   Rangefinder | Tidal Insurance | entry draw  people who entered at /golf, in
 *                                               the order fixed when they entered
 *   $500 gift card | Hyphos Inc. | square       people who posted "in the square"
 *
 * Those three need "Load contest entries" once, signed in, before dinner. After
 * that the screen runs offline like everything else here.
 *
 * Nobody wins twice across any prize, matched by name. R marks the winner
 * absent for the rest of the night and moves to the next person for that
 * prize. U undoes the current prize's winner. S opens setup and the export.
 *
 * ?demo=1 rehearses with sample data under its own storage key, so practising
 * on the presentation laptop never touches the real lists or winners.
 */
---

<BaseLayout title="Prize draw" noindex minimal>
  <canvas id="fx"></canvas>

  <!-- ── Setup: paste the lists, strike the score winners, start ── -->
  <div id="setup">
    <div class="setup-head">
      <div class="brand"><Mark size={28} color="#c9a46a" /> <span>hyphos · prize draw</span></div>
      <p class="setup-note">1. Check the names below, fix any, and tick the teams that won on score. 2. Press Start The Draw: it opens the projector window, and this window becomes your control screen. There is no prize list: regular prizes keep coming until you end the draw. Everything stays on this laptop.</p>
    </div>

    <div class="setup-row top-actions">
      <button id="btn-start" type="button" class="primary">Start The Draw</button>
      <button id="btn-export" type="button" disabled>Export Winners CSV</button>
      <button id="btn-reset" type="button" class="danger">Reset Everything</button>
    </div>
    <p id="start-note" class="warn" hidden></p>

    <!-- Live control: this window stays on the laptop, the draw shows in the projector window. -->
    <section id="control" hidden>
      <div class="c-head">
        <h2>Live Draw</h2>
        <span id="c-conn" class="c-conn">Projector window not open</span>
      </div>
      <div class="c-now">
        <p id="c-kicker" class="c-kicker"></p>
        <p id="c-prize" class="c-prize"></p>
        <p id="c-quote" class="c-quote" hidden></p>
        <p id="c-reel" class="c-reel"></p>
        <p id="c-sub" class="c-sub"></p>
        <p id="c-count" class="muted"></p>
      </div>
      <div id="c-pick" class="c-pick" hidden>
        <p class="c-pick-head">Choose the Pro V1s winner. Read them; length does not decide it.</p>
        <ol id="c-pick-list"></ol>
        <p class="muted" id="c-pick-empty" hidden>No answers yet. Nobody has entered on the form.</p>
      </div>
      <div class="setup-row c-buttons">
        <button id="c-next" type="button" class="primary">Next</button>
        <button id="c-redraw" type="button">They Have Left, Redraw</button>
        <button id="c-undo" type="button">Undo</button>
        <button id="c-title" type="button">Title Slide</button>
        <button id="c-end" type="button">End The Draw</button>
        <button id="c-open" type="button">Open Projector Window</button>
      </div>
      <div class="setup-row c-buttons">
        <span class="muted">Switch to:</span>
        <button id="c-regular" type="button">Regular Prize</button>
        <span id="c-specials"></span>
      </div>
      <p class="muted">Drag the projector window onto the projector and click it once to go full screen. The clicker works in either window: Next draws, Back twice redraws someone who has left, or at Ready switches to the next Hyphos prize. After a Hyphos prize, Next goes back to regular prizes. Regular prizes keep coming until you press End The Draw. <a id="c-here" href="#">Show the draw in this window instead</a>.</p>
    </section>
    <div class="setup-row">
      <button id="btn-parse" type="button" hidden>Reload Lists</button>
      <span id="parse-note" class="muted"></span>
    </div>
    <div id="exclude-wrap" hidden>
      <h2>Golfers And Teams</h2>
      <p class="muted">Tick a team to take the whole team out of the draw (won on score). Tick a single name to take out one person. Removed names never come up.
        Click any name to fix it. Add a player to a team, or a whole new team, if someone turns up who is not on the list. Blank slots are ignored.
        Press Check In as each golfer arrives.</p>
      <div class="list-tools">
        <input id="golfer-search" type="search" placeholder="Search a name or team" autocomplete="off" spellcheck="false" />
        <span id="checkin-count" class="muted"></span>
        <label class="only-checked"><input id="only-checked" type="checkbox" /> Only draw golfers who are checked in</label>
      </div>
      <div id="exclude-list"></div>
      <p id="search-empty" class="muted" hidden>No golfer or team matches that.</p>
      <div class="setup-row"><button id="btn-add-team" type="button">Add A Team</button></div>
    </div>

    <div id="contest-wrap" hidden>
      <h2>Hyphos Prize Entries</h2>
      <p class="muted">The Tidal prize draws from the entry form and the Pro V1s from the judged answer. Entries load when you press Start and again each time you switch to a Hyphos prize, so late entries are in.</p>
      <div class="setup-row">
        <button id="btn-contest" type="button">Load Contest Entries</button>
        <span id="contest-note" class="muted"></span>
      </div>
      <p id="judge-note" class="warn" hidden></p>
    </div>

    <h2 class="sub-h">Hyphos Prizes</h2>
    <div class="setup-grid">
      <label hidden>
        <span>Golfers, loaded from the tournament roster. One per line: <em>Name, Team</em></span>
        <textarea id="in-attendees" rows="14" spellcheck="false" placeholder="Marc Dube, Dube Excavating&#10;Jen Kwan, Foothills Dental"></textarea>
      </label>
      <label>
        <span>The Hyphos prizes, each switched to from the control screen whenever you choose: <em>Prize | Sponsor | how</em>. <em>entry draw</em> draws from the entry form, <em>best answer</em> is the judged pick. Leave it as is unless something changes.</span>
        <textarea id="in-prizes" rows="3" spellcheck="false"></textarea>
      </label>
    </div>

    <div id="winners-wrap" hidden>
      <h2>Winners So Far</h2>
      <ol id="winners-list"></ol>
    </div>

  </div>

  <!-- ── Stage: what the room sees ── -->
  <div id="stage" hidden>

    <main id="centre">
      <section id="s-title" class="screen on">
        <img class="mos-lion" src="/golf/mos-lion.png" alt="Men of Springs" width="487" height="514" />
        <p class="kicker">Springs Men's Golf Classic</p>
        <h1 class="huge">The prize draw.</h1>
      </section>

      <section id="s-prize" class="screen">
        <p class="kicker" id="p-sponsor"></p>
        <h1 class="prize" id="p-name"></h1>
        <div id="quote" hidden>
          <p id="q-wish"></p>
          <p id="q-detail"></p>
        </div>
        <div id="reel">Ready</div>
        <p class="sub" id="p-sub">Next: draw</p>
      </section>

      <section id="s-done" class="screen">
        <img class="mos-lion" src="/golf/mos-lion.png" alt="Men of Springs" width="487" height="514" />
        <p class="kicker">That's every prize</p>
        <h1 class="huge">Thanks for a great day.</h1>
        <p class="sub">Daniel is at table six. The list is hitting your inbox tonight.</p>
      </section>
    </main>

    <!-- Small, like the footer on the hole signage: the prizes are the show. -->
    <footer class="frame-bottom">
      <div class="foot-left">
        <div class="brand"><Mark size={26} color="#c9a46a" /> <span>hyphos</span></div>
        <p class="count" id="counter"></p>
      </div>
      <img class="foot-lion" src="/golf/mos-lion.png" alt="Men of Springs" width="487" height="514" />
      <div class="foot-right">
        <p class="line"><span class="l1">Stop being the admin.</span> <span class="l2">Focus on what matters.</span><br /><span class="url">hyphos.io</span></p>
        <img src="/golf/qr-screen.png" alt="QR code for hyphos.io" width="220" height="220" />
      </div>
    </footer>
  </div>

  <style is:global>
    :root { color-scheme: dark; --gold: #c9a46a; --paper: #faf8f4; --muted: #9aa3b2; --bg: #101214; --panel: #171a1e; --rule: #2a2f36; }
    body { background: var(--bg); color: var(--paper); font-family: 'Inter', system-ui, sans-serif; margin: 0; }
    [hidden] { display: none !important; }

    /* setup */
    #setup { max-width: 1100px; margin: 0 auto; padding: 32px 24px 80px; }
    .setup-head { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; letter-spacing: .02em; }
    .brand span { font-size: 18px; }
    .setup-note, .muted { color: var(--muted); font-size: 14px; margin: 0; }
    .setup-grid { display: grid; grid-template-columns: 1fr; gap: 16px; max-width: 760px; }
    .setup-grid label { display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: var(--muted); }
    .setup-grid em { color: var(--gold); font-style: normal; }
    textarea { width: 100%; box-sizing: border-box; background: var(--panel); color: var(--paper); border: 1px solid var(--rule); border-radius: 6px; padding: 10px 12px; font: 14px/1.45 ui-monospace, Menlo, monospace; }
    .setup-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 18px 0; }
    button { background: var(--panel); color: var(--paper); border: 1px solid var(--rule); border-radius: 6px; padding: 9px 14px; font: 500 14px 'Inter', system-ui, sans-serif; cursor: pointer; }
    button.primary { background: var(--gold); color: #141414; border-color: var(--gold); }
    button.danger { color: #e08a7a; }
    button:disabled { opacity: .45; cursor: default; }
    #setup h2 { font-size: 15px; letter-spacing: .16em; text-transform: uppercase; color: var(--gold); margin: 26px 0 6px; font-weight: 600; }
    #exclude-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px 22px; margin-top: 12px; }
    .team { border: 1px solid var(--rule); border-radius: 6px; padding: 10px 12px; }
    .team-head { display: flex; align-items: center; gap: 8px; font-weight: 600; margin-bottom: 6px; }
    .person { display: flex; align-items: center; gap: 8px; font-size: 14px; padding: 3px 0; }
    .person.out, .team.out .person { color: var(--muted); text-decoration: line-through; }
    .team input[type=text] { flex: 1; min-width: 0; background: transparent; color: inherit; border: 1px solid transparent; border-radius: 4px; padding: 3px 6px; font: inherit; text-decoration: inherit; }
    .team input[type=text]:hover { border-color: var(--rule); }
    .team input[type=text]:focus { border-color: var(--gold); outline: none; background: var(--bg); }
    .team input[type=text]::placeholder { color: #5b616b; text-decoration: none; }
    .team-head input[type=text] { font-weight: 600; }
    .person.won input[type=text] { color: var(--gold); }
    .person .tag { flex: none; font-size: 11px; font-weight: 600; letter-spacing: .04em; color: #141414; background: var(--gold); border-radius: 99px; padding: 2px 8px; white-space: nowrap; }
    .list-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin: 14px 0 4px; }
    #golfer-search { flex: 1 1 280px; max-width: 420px; background: var(--panel); color: var(--paper); border: 1px solid var(--rule); border-radius: 6px; padding: 10px 12px; font: 15px 'Inter', system-ui, sans-serif; }
    #golfer-search:focus { border-color: var(--gold); outline: none; }
    .only-checked { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--muted); }
    .person .in { flex: none; font-size: 12px; padding: 3px 9px; border-radius: 99px; background: none; border: 1px solid var(--rule); color: var(--muted); }
    .person .in:hover { border-color: #8fc79a; color: #8fc79a; }
    .person .in.on { background: #1f3325; border-color: #3f6b4a; color: #8fc79a; }
    .person .tag.gone { background: var(--rule); color: var(--muted); border: 0; cursor: pointer; font-family: inherit; }
    .person .tag.gone:hover { background: #3a4048; color: var(--paper); }
    .person .x { background: none; border: 0; color: var(--muted); padding: 2px 6px; font-size: 16px; line-height: 1; }
    .person .x:hover { color: #e08a7a; }
    .team .add { margin-top: 6px; padding: 4px 10px; font-size: 13px; color: var(--muted); }
    #control { border: 1px solid var(--gold); border-radius: 10px; padding: 18px 20px; margin: 0 0 26px; background: var(--panel); }
    #control h2 { margin: 0 !important; }
    .c-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
    .c-conn { font-size: 13px; color: #e08a7a; }
    .c-conn.on { color: #8fc79a; }
    .c-now { margin: 14px 0 4px; min-height: 120px; }
    .c-now p { margin: 0; }
    .c-kicker { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--gold); }
    .c-prize { font-size: 22px; margin-top: 4px !important; }
    .c-quote { font-size: 15px; color: var(--muted); font-style: italic; margin-top: 6px !important; }
    .c-reel { font-size: 34px; color: var(--gold); font-family: 'Source Serif 4', Georgia, serif; margin-top: 8px !important; }
    .c-reel.spinning { color: #6b7280; }
    .c-sub { font-size: 14px; color: var(--paper); margin-top: 8px !important; }
    .c-buttons button { padding: 12px 18px; font-size: 15px; }
    #c-next { min-width: 140px; }
    #c-specials { display: inline-flex; flex-wrap: wrap; gap: 12px; }
    .c-pick { border-top: 1px solid var(--rule); margin-top: 14px; padding-top: 12px; }
    .c-pick-head { font-size: 14px; color: var(--paper); margin: 0 0 8px; }
    #c-pick-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; max-height: 360px; overflow: auto; }
    #c-pick-list li { display: flex; gap: 14px; align-items: flex-start; justify-content: space-between; border: 1px solid var(--rule); border-radius: 8px; padding: 10px 12px; }
    #c-pick-list li.chosen { border-color: var(--gold); background: #2a2419; }
    #c-pick-list .a-wish { font-weight: 600; }
    #c-pick-list .a-detail { color: var(--muted); font-size: 14px; margin-top: 2px; }
    #c-pick-list .a-who { color: var(--muted); font-size: 12px; margin-top: 4px; }
    #c-pick-list button { flex: none; }
    .screen-mode #p-sub { visibility: hidden; }
    .replaced { position: fixed; inset: 0; z-index: 20; display: grid; place-items: center; background: var(--bg); color: var(--muted); font-size: 22px; padding: 24px; text-align: center; }
    #winners-list { padding-left: 20px; margin: 8px 0 0; font-size: 14px; line-height: 1.6; }
    #winners-list span { color: var(--muted); }

    /* stage */
    #stage { position: fixed; inset: 0; display: grid; grid-template-rows: 1fr auto; overflow: hidden; }
    .frame-bottom { display: flex; justify-content: space-between; align-items: center; gap: 3vmin; padding: 1.8vmin 4vmin; border-top: 1px solid var(--rule); }
    .foot-left { display: flex; align-items: center; gap: 3vmin; }
    .foot-left .brand span { font-size: clamp(14px, 1.5vw, 24px); }
    .count { margin: 0; color: var(--muted); font-size: clamp(11px, 1.05vw, 18px); letter-spacing: .08em; text-transform: uppercase; }
    .mos-lion { display: block; width: clamp(90px, 16vmin, 240px); height: auto; margin: 0 auto 3vmin; }
    .frame-bottom { position: relative; }
    .foot-lion { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: clamp(28px, 5vmin, 64px); height: auto; opacity: .9; }
    .foot-right { display: flex; align-items: center; gap: 2vmin; text-align: right; }
    .foot-right .line { margin: 0; font-size: clamp(12px, 1.15vw, 20px); line-height: 1.35; }
    .foot-right .l1 { font-weight: 300; color: var(--paper); }
    .foot-right .l2 { font-weight: 600; color: var(--gold); }
    .foot-right .url { color: var(--muted); font-size: .8em; }
    .foot-right img { width: clamp(56px, 8vmin, 120px); height: auto; border-radius: 4px; }
    .warn { color: #e6c58a; font-size: 14px; margin: 6px 0 0; }
    .warn a { color: var(--gold); }
    #quote { max-width: min(86vw, 1300px); margin: 3vmin auto 0; }
    #q-wish { font-family: 'Source Serif 4', Georgia, serif; font-size: clamp(26px, 4vw, 72px); line-height: 1.12; margin: 0; color: var(--paper); max-width: 22ch; margin-inline: auto; }
    #q-detail { font-size: clamp(15px, 1.8vw, 32px); color: var(--muted); font-style: italic; line-height: 1.4; margin: 2.2vmin auto 0; max-width: 42ch; }

    #centre { display: grid; place-items: center; text-align: center; padding: 2vmin 4vmin; min-height: 0; }
    .screen { display: none; max-width: 92vw; }
    .screen.on { display: block; animation: rise .5s ease both; }
    @keyframes rise { from { opacity: 0; transform: translateY(2vmin); } to { opacity: 1; transform: none; } }
    .kicker { font-size: clamp(14px, 1.7vw, 30px); letter-spacing: .28em; text-transform: uppercase; color: var(--gold); margin: 0 0 2.5vmin; font-weight: 600; min-height: 1.2em; }
    .huge { font-family: 'Source Serif 4', Georgia, serif; font-weight: 500; font-size: clamp(40px, 7.5vw, 140px); line-height: 1.02; margin: 0; }
    .prize { font-family: 'Source Serif 4', Georgia, serif; font-weight: 500; font-size: clamp(30px, 5vw, 90px); line-height: 1.08; margin: 0; color: var(--paper); max-width: 24ch; margin-inline: auto; }
    .sub { font-size: clamp(16px, 2vw, 36px); color: var(--muted); margin: 3vmin 0 0; }
    /* Directions are for whoever holds the clicker, not the room: small and quiet. */
    #p-sub { font-size: clamp(11px, .95vw, 16px); letter-spacing: .02em; opacity: .6; margin-top: 4vmin; }
    #reel { font-family: 'Source Serif 4', Georgia, serif; font-weight: 500; font-size: clamp(38px, 7.5vw, 132px); line-height: 1.05; min-height: 1.2em; margin: 3vmin 0 0; color: var(--gold); }
    #reel.spinning { color: #6b7280; }
    #reel .co { display: block; font-family: 'Inter', system-ui, sans-serif; font-size: clamp(16px, 2.2vw, 38px); color: var(--muted); margin-top: 1.5vmin; }
    #reel.landed { animation: pop .55s cubic-bezier(.2,1.5,.3,1) both; }
    @keyframes pop { 0% { transform: scale(.86); opacity: .4; } 100% { transform: scale(1); opacity: 1; } }
    #fx { position: fixed; inset: 0; pointer-events: none; z-index: 5; }
    @media (prefers-reduced-motion: reduce) { .screen.on, #reel.landed { animation: none; } }
  </style>

  <script>
    const DEMO = new URLSearchParams(location.search).has('demo');
    // Rehearsal gets its own storage. Sharing one key meant ?demo=1 on the
    // presentation laptop resumed, and recorded winners into, the real draw.
    // v2: open-ended draw with the Hyphos prizes at the end. Saves from the old
    // fixed prize list are ignored rather than half-read.
    const KEY = DEMO ? 'hyphos-golf-prizes-demo-v3' : 'hyphos-golf-prizes-v3';
    const PICK_KEY = DEMO ? 'hyphos-golf-best-pick-demo' : 'hyphos-golf-best-pick';
    const el = (id) => document.getElementById(id);
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const norm = (name) => String(name || '').trim().replace(/\s+/g, ' ').toLowerCase();

    // state ---------------------------------------------------------------
    // attendees: [{id, name, team}]
    // prizes:    [{prize, sponsor, kind}]  kind: hat | judged | entries | square
    // excluded:  attendee ids struck for score prizes
    // absent:    normalised names called but not in the room, out for the night
    // winners:   [{prizeIndex, name, team, prize, sponsor, kind, at}]
    // contest:   snapshot of the contest data, so the draw runs offline
    // prizes:    grows as the night goes: one "Prize N" per regular draw, with a
    //            Hyphos prize dropped in wherever you choose ({ special: i }).
    // finale:    the Hyphos prizes, from the setup box. Each can be drawn once,
    //            at any point, and the draw goes back to regular prizes after.
    // checkedIn: golfer ids checked in on arrival. onlyCheckedIn: when on, the
    //            regular draws only pick from checked-in golfers.
    let S = { attendees: [], prizes: [], finale: [], excluded: [], absent: [], winners: [], checkedIn: [], onlyCheckedIn: false, contest: null, index: 0, phase: 'title', started: false };
    const DEFAULT_FINALE = ['A prize from Tidal | Tidal Insurance | entry draw', 'Dozen Pro V1s | Hyphos Inc. | best answer'].join('\n');
    const specialDone = (i) => S.winners.some((w) => S.prizes[w.prizeIndex]?.special === i);
    const nextSpecial = () => S.finale.findIndex((_, i) => !specialDone(i));
    // Short names for the buttons and directions. The projector still shows
    // the full prize name from the setup box.
    const shortName = (p) => p.kind === 'entries' ? 'Tidal Prize' : p.kind === 'judged' ? 'Hyphos Prize' : p.prize;
    let landed = false;      // the current prize has a winner on screen
    let quoteUp = false;     // judged prize: the answer is showing, name not yet

    const save = () => { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch {} };
    const loadState = () => {
      try {
        const raw = localStorage.getItem(KEY);
        if (raw) S = { ...S, ...JSON.parse(raw) };
        // Absent entries are "a:<attendee id>" or "n:<name>". Older saves held
        // bare names or bare ids.
        S.absent = (S.absent || []).map((a) => typeof a === 'number' ? `a:${a}` : /^[an]:/.test(a) ? a : `n:${a}`);
      } catch {}
    };

    // parsing ---------------------------------------------------------------
    // Accepts "Name, Team", "Name<tab>Team" or "Name". Blank lines and a
    // header row that literally says "name" are ignored.
    function parseAttendees(text) {
      const out = [];
      text.split(/\r?\n/).forEach((line, i) => {
        const cells = line.split(/\t|,/).map((c) => c.trim()).filter(Boolean);
        if (!cells.length) return;
        if (i === 0 && /^name$/i.test(cells[0])) return;
        out.push({ id: out.length + 1, name: cells[0], team: cells[1] || '' });
      });
      return out;
    }

    const TAGS = {
      'best answer': 'judged', judged: 'judged',
      'entry draw': 'entries', entries: 'entries', 'golf entries': 'entries',
      square: 'square', 'in the square': 'square',
    };
    // "Prize | Sponsor | tag". A dash with spaces around it also separates, so
    // lists pasted from elsewhere still work.
    function parsePrizes(text) {
      return text.split(/\r?\n/).map((l) => l.trim()).filter(Boolean).map((line) => {
        const parts = line.split(/\s+[—–-]\s+|\s*\|\s*/).map((x) => x.trim()).filter(Boolean);
        let kind = 'hat';
        if (parts.length > 1 && TAGS[parts[parts.length - 1].toLowerCase()]) kind = TAGS[parts.pop().toLowerCase()];
        return { prize: parts[0] || '', sponsor: parts[1] || '', kind };
      });
    }
    const hasContestPrizes = () => (S.finale || []).some((p) => p.kind !== 'hat');

    // who can still win -----------------------------------------------------
    function pick(arr) {
      const buf = new Uint32Array(1);
      crypto.getRandomValues(buf);
      return arr[buf[0] % arr.length];
    }
    // Who is out for this prize. Attendees are tracked by their row, not their
    // name: the real roster repeats names (three "Kaizen Auto" rows, three
    // "Michael Lynes"), and matching by name let one of them winning knock the
    // others out of the hat. Contest entrants typed their own names, so they
    // are matched to an attendee row only when exactly one row has that name.
    function attendeeId(name) {
      const hits = S.attendees.filter((a) => norm(a.name) === norm(name));
      return hits.length === 1 ? hits[0].id : null;
    }
    const others = () => S.winners.filter((w) => w.prizeIndex !== S.index);
    function blockedIds() {
      const ids = new Set(S.excluded);
      others().forEach((w) => { if (w.attendee != null) ids.add(w.attendee); });
      S.absent.forEach((a) => { if (a.startsWith('a:')) ids.add(Number(a.slice(2))); });
      return ids;
    }
    // Names blocked for contest prizes, where entrants have no attendee row.
    function blockedNames() {
      const ids = blockedIds();
      const names = new Set();
      others().forEach((w) => names.add(norm(w.name)));
      S.absent.forEach((a) => { if (a.startsWith('n:')) names.add(a.slice(2)); });
      S.attendees.forEach((a) => { if (ids.has(a.id)) names.add(norm(a.name)); });
      return names;
    }
    function pool() {
      const ids = blockedIds();
      // A contest winner with no attendee row still blocks the one row that
      // uniquely carries their name.
      const loose = new Set([
        ...others().filter((w) => w.attendee == null).map((w) => norm(w.name)),
        ...S.absent.filter((a) => a.startsWith('n:')).map((a) => a.slice(2)),
      ]);
      const here = new Set(S.checkedIn || []);
      return S.attendees.filter((a) => a.name.trim() && !ids.has(a.id) && (!S.onlyCheckedIn || here.has(a.id))
        && !(loose.has(norm(a.name)) && attendeeId(a.name) === a.id));
    }
    const teamFor = (name, fallback = '') => {
      const id = attendeeId(name);
      return (id != null && S.attendees.find((a) => a.id === id)?.team) || fallback;
    };

    function judgedOrder() {
      const best = S.contest?.best || [];
      let pickId = NaN;
      try { pickId = Number(localStorage.getItem(PICK_KEY)); } catch {}
      const i = best.findIndex((b) => b.id === pickId);
      return { chosen: i >= 0, list: i > 0 ? [best[i], ...best.filter((_, j) => j !== i)] : best };
    }
    // Candidates for the current prize, in the order they would be chosen.
    function candidatesFor(prize) {
      const b = blockedNames();
      // The Pro V1s are judged, not drawn: they go to the chosen answer even if
      // that person already won something tonight. Only someone who has left
      // (R) is skipped.
      if (prize.kind === 'judged') {
        const gone = new Set(S.absent.filter((x) => x.startsWith('n:')).map((x) => x.slice(2)));
        S.absent.filter((x) => x.startsWith('a:')).forEach((x) => { const a = S.attendees.find((r) => r.id === Number(x.slice(2))); if (a) gone.add(norm(a.name)); });
        return judgedOrder().list.filter((x) => !gone.has(norm(x.name)));
      }
      if (prize.kind === 'entries') return (S.contest?.draw || []).filter((x) => !b.has(norm(x.name)));
      if (prize.kind === 'square') return (S.contest?.square || []).filter((x) => !b.has(norm(x.name)));
      return pool();
    }

    // setup UI --------------------------------------------------------------
    // Golfers and teams, editable in place. Every golfer keeps their id through
    // an edit, so removals and winners stay attached to the right person. Edits
    // save on change (leaving the field or Enter), not per keystroke, so the
    // projector window is not repainted while you type.
    const nextId = () => S.attendees.reduce((m, a) => Math.max(m, a.id), 0) + 1;
    function textField(value, placeholder, onSave) {
      const f = document.createElement('input'); f.type = 'text'; f.value = value; f.placeholder = placeholder; f.spellcheck = false;
      f.addEventListener('change', () => { onSave(f.value.trim().replace(/\s+/g, ' ')); save(); updateStart(); });
      f.addEventListener('keydown', (e) => { if (e.key === 'Enter') f.blur(); });
      return f;
    }
    function renderExclude() {
      const wrap = el('exclude-list'); wrap.replaceChildren();
      const ex = new Set(S.excluded);
      // Who has won what, and who was called but had left, by golfer id.
      const won = new Map();
      S.winners.forEach((w) => { if (w.attendee != null) won.set(w.attendee, [...(won.get(w.attendee) || []), w.prize]); });
      const gone = new Set(S.absent.filter((a) => a.startsWith('a:')).map((a) => Number(a.slice(2))));
      const teams = new Map();
      S.attendees.forEach((a) => { const k = a.team || ''; if (!teams.has(k)) teams.set(k, []); teams.get(k).push(a); });
      teams.forEach((members, team) => {
        const box = document.createElement('div'); box.className = 'team';
        const named = members.filter((m) => m.name.trim());
        const allOut = named.length > 0 && named.every((m) => ex.has(m.id));
        if (allOut) box.classList.add('out');
        const head = document.createElement('div'); head.className = 'team-head';
        const tcb = document.createElement('input'); tcb.type = 'checkbox'; tcb.checked = allOut; tcb.title = 'Won on score: remove the whole team';
        tcb.addEventListener('change', () => {
          const set = new Set(S.excluded);
          members.forEach((m) => tcb.checked ? set.add(m.id) : set.delete(m.id));
          S.excluded = [...set]; save(); renderExclude(); updateStart();
        });
        // Renaming a team renames it for everyone on it.
        // Looked up by id at save time: the list may have been reloaded since
        // this row was drawn (a winner recorded on the projector).
        const ids = new Set(members.map((m) => m.id));
        const tname = textField(team, 'Team name', (v) => { S.attendees.forEach((a) => { if (ids.has(a.id)) a.team = v; }); });
        head.append(tcb, tname);
        box.append(head);
        members.forEach((m) => {
          const row = document.createElement('div'); row.className = 'person' + (ex.has(m.id) ? ' out' : '');
          const cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = ex.has(m.id); cb.title = 'Remove from the draw';
          cb.addEventListener('change', () => {
            const set = new Set(S.excluded); cb.checked ? set.add(m.id) : set.delete(m.id);
            S.excluded = [...set]; save(); renderExclude(); updateStart();
          });
          // Every row gets a Check In button; it shows once the row has a name,
          // including a name typed into an open slot.
          const inBtn = document.createElement('button'); inBtn.type = 'button';
          const name = textField(m.name, 'Add a name', (v) => {
            const cur = S.attendees.find((a) => a.id === m.id); if (cur) cur.name = v;
            inBtn.hidden = !v;
            if (!v) S.checkedIn = (S.checkedIn || []).filter((id) => id !== m.id);
          });
          const x = document.createElement('button'); x.type = 'button'; x.className = 'x'; x.textContent = '×'; x.title = 'Delete this player';
          x.addEventListener('click', () => {
            if (m.name.trim() && !confirm(`Delete ${m.name} from the list?`)) return;
            S.attendees = S.attendees.filter((a) => a.id !== m.id);
            S.excluded = S.excluded.filter((id) => id !== m.id);
            S.checkedIn = (S.checkedIn || []).filter((id) => id !== m.id);
            save(); renderExclude(); updateStart();
          });
          row.dataset.id = String(m.id);
          row.append(cb, name);
          {
            inBtn.hidden = !m.name.trim();
            const paint = () => { const on = (S.checkedIn || []).includes(m.id); inBtn.className = on ? 'in on' : 'in'; inBtn.textContent = on ? 'Here ✓' : 'Check In'; };
            paint();
            inBtn.addEventListener('click', () => {
              const set = new Set(S.checkedIn || []);
              set.has(m.id) ? set.delete(m.id) : set.add(m.id);
              S.checkedIn = [...set]; save(); paint(); updateStart();
            });
            row.append(inBtn);
          }
          if (won.has(m.id)) {
            row.classList.add('won');
            const tag = document.createElement('span'); tag.className = 'tag'; tag.textContent = `Won ${won.get(m.id).join(', ')}`;
            row.append(tag);
          } else if (gone.has(m.id)) {
            // Marked absent by a redraw. Click to put them back in the draw, if
            // they were in the room after all.
            const tag = document.createElement('button'); tag.type = 'button'; tag.className = 'tag gone';
            tag.textContent = 'Not here ×'; tag.title = 'They are here after all: put them back in the draw';
            tag.addEventListener('click', () => {
              S.absent = S.absent.filter((x) => x !== `a:${m.id}` && x !== `n:${norm(m.name)}`);
              save(); renderExclude(); updateStart();
            });
            row.append(tag);
          }
          row.append(x);
          box.append(row);
        });
        const add = document.createElement('button'); add.type = 'button'; add.className = 'add'; add.textContent = '+ Add Player';
        add.addEventListener('click', () => {
          const id = nextId();
          S.attendees.push({ id, name: '', team: S.attendees.find((a) => ids.has(a.id))?.team ?? team });
          save(); renderExclude(); updateStart();
          [...el('exclude-list').querySelectorAll('.person input[type=text]')].pop()?.focus();
        });
        box.append(add);
        wrap.append(box);
      });
      el('exclude-wrap').hidden = !S.attendees.length;
      applySearch();
    }
    // Filters what is shown, never what is saved. A team name match shows the
    // whole team; otherwise only the matching golfers.
    function applySearch() {
      const q = norm(el('golfer-search').value);
      let any = false;
      el('exclude-list').querySelectorAll('.team').forEach((box) => {
        const teamHit = !q || norm(box.querySelector('.team-head input[type=text]').value).includes(q);
        let rowHit = false;
        box.querySelectorAll('.person').forEach((row) => {
          const hit = teamHit || norm(row.querySelector('input[type=text]').value).includes(q);
          row.hidden = !hit; if (hit) rowHit = true;
        });
        box.hidden = !(teamHit || rowHit);
        if (!box.hidden) any = true;
      });
      el('search-empty').hidden = any || !q;
    }
    function renderWinners() {
      const ol = el('winners-list'); ol.replaceChildren();
      S.winners.forEach((w) => {
        const li = document.createElement('li');
        li.textContent = `${w.name}${w.team ? ' · ' + w.team : ''} `;
        const s = document.createElement('span'); s.textContent = `: ${w.prize}${w.sponsor ? ' (' + w.sponsor + ')' : ''}`;
        li.append(s); ol.append(li);
      });
      el('winners-wrap').hidden = !S.winners.length;
      el('btn-export').disabled = !S.winners.length;
    }
    function renderContest() {
      el('contest-wrap').hidden = !hasContestPrizes();
      const c = S.contest;
      el('contest-note').textContent = c
        ? `Loaded ${new Date(c.loadedAt).toLocaleTimeString('en-CA', { hour: 'numeric', minute: '2-digit' })}: ${c.best.length} answers for the Pro V1s, ${c.draw.length} names in the entry draw`
        : 'Not loaded yet.';
      const note = el('judge-note');
      const needsJudge = (S.finale || []).some((p) => p.kind === 'judged');
      note.replaceChildren();
      note.hidden = true;
      if (needsJudge && c && c.best.length && !judgedOrder().chosen) {
        note.hidden = false;
        note.append(document.createTextNode('No judged winner chosen on this laptop yet. '));
        const a = document.createElement('a'); a.href = DEMO ? '/golf/judge?demo=1' : '/golf/judge'; a.textContent = 'Choose The Best Answer';
        note.append(a, document.createTextNode(', then come back. Nothing here is lost.'));
      }
    }
    function updateStart() {
      const n = pool().length;
      const contestReady = !hasContestPrizes() || !!S.contest;
      el('parse-note').textContent = S.attendees.length
        ? `${S.attendees.filter((a) => a.name.trim()).length} golfers, ${S.excluded.length} removed, ${(S.checkedIn || []).length} checked in, ${n} in the hat · Hyphos draw: ${S.finale.length} prize${S.finale.length === 1 ? '' : 's'}${contestReady ? '' : ' · contest entries load when you press Start'}`
        : '';
      el('only-checked').checked = !!S.onlyCheckedIn;
      el('checkin-count').textContent = `${(S.checkedIn || []).length} of ${S.attendees.filter((a) => a.name.trim()).length} checked in`;
      el('control').hidden = !S.started;
      el('btn-start').hidden = !!S.started;
      renderSpecials();
      renderContest();
    }

    async function loadContest() {
      el('contest-note').textContent = 'Loading…';
      if (DEMO) {
        S.contest = {
          loadedAt: new Date().toISOString(),
          // Same ids as the judge page's demo answers, so a rehearsal pick there works here.
          best: [
            { id: 1, name: 'Dale Ross', company: 'Ross Electric', wish: 'invoicing', detail: 'Two full evenings a month I will never get back.' },
            { id: 2, name: 'Sam Doyle', company: 'Doyle Roofing', wish: 'quotes', detail: 'I write them at 10pm after the kids are down.' },
            { id: 3, name: 'Chris Bell', company: 'Bell Auto Glass', wish: 'the schedule', detail: 'One cancellation and I rebuild the whole week by hand.' },
          ],
          draw: [
            { name: 'Nina Faust', company: 'Faust Realty' }, { name: 'Rob Fenn', company: 'Fenn HVAC' },
            { name: 'Visiting Guest', company: '' }, { name: 'Tara Nolan', company: 'Nolan Bakery' },
          ],
          square: [{ name: 'Kyle Brenner', team: 'Brenner Concrete' }, { name: 'Jen Kwan', team: 'Foothills Dental' }, { name: 'Lena Ortiz', team: 'Ortiz Physio' }],
        };
        save(); updateStart(); return;
      }
      try {
        const [summaryRes, boardRes] = await Promise.all([
          fetch('/api/golf/summary?format=json', { cache: 'no-store' }),
          fetch('/api/course/board', { cache: 'no-store' }),
        ]);
        if (summaryRes.status === 401) {
          el('contest-note').replaceChildren(document.createTextNode('Not signed in on this laptop. '));
          const a = document.createElement('a'); a.href = '/golf/enter?next=' + encodeURIComponent(location.pathname + location.search); a.textContent = 'Sign in'; a.style.color = 'var(--gold)';
          el('contest-note').append(a, document.createTextNode(', then load again.'));
          return;
        }
        if (!summaryRes.ok || !boardRes.ok) throw new Error('load');
        const summary = await summaryRes.json();
        const board = await boardRes.json();
        const square = board.contests?.find((c) => c.mode === 'list')?.entries || [];
        S.contest = {
          loadedAt: new Date().toISOString(),
          best: (summary.best || []).map((b) => ({ id: b.id, name: b.name, company: b.company || '', wish: b.wish || '', detail: b.detail || '' })),
          draw: (summary.draw || []).map((d) => ({ name: d.name, company: d.company || '' })),
          square: square.map((e) => ({ name: e.player, team: e.team || '' })),
        };
        save(); updateStart();
      } catch {
        el('contest-note').textContent = 'Could not load. Check the connection and try again. Anything loaded before is kept.';
      }
    }

    el('btn-parse').addEventListener('click', () => {
      if ((S.excluded.length || S.winners.length) && !confirm('Reloading clears the removed teams and any winners drawn. Continue?')) return;
      S.attendees = parseAttendees(el('in-attendees').value);
      S.finale = parsePrizes(el('in-prizes').value); S.prizes = [];
      S.excluded = []; S.absent = []; S.winners = []; S.index = 0; S.phase = 'title'; S.started = false;
      save(); renderExclude(); renderWinners(); updateStart();
    });
    el('btn-contest').addEventListener('click', loadContest);
    el('golfer-search').addEventListener('input', applySearch);
    el('golfer-search').addEventListener('keydown', (e) => { if (e.key === 'Escape') { el('golfer-search').value = ''; applySearch(); } });
    el('only-checked').addEventListener('change', () => { S.onlyCheckedIn = el('only-checked').checked; save(); updateStart(); });
    // A new team with four blank slots, for anyone who turns up unlisted.
    el('btn-add-team').addEventListener('click', () => {
      const used = new Set(S.attendees.map((a) => a.team));
      let n = 1; while (used.has(`Extra Team ${n}`)) n += 1;
      const first = nextId();
      for (let i = 0; i < 4; i++) S.attendees.push({ id: first + i, name: '', team: `Extra Team ${n}` });
      save(); renderExclude(); updateStart();
      const boxes = el('exclude-list').querySelectorAll('.team');
      boxes[boxes.length - 1]?.scrollIntoView({ block: 'center' });
      boxes[boxes.length - 1]?.querySelector('.person input[type=text]')?.focus();
    });
    // Start never sits greyed out. It picks up anything typed since the last
    // load, fetches the contest entries if they are needed, and otherwise says
    // exactly what is missing.
    el('btn-start').addEventListener('click', async () => {
      const note = el('start-note');
      const say = (msg) => { note.textContent = msg; note.hidden = !msg; };
      say('');
      if (!S.winners.length) {
        const typed = parsePrizes(el('in-prizes').value);
        if (JSON.stringify(typed) !== JSON.stringify(S.finale)) { S.finale = typed; save(); renderContest(); }
        if (!S.attendees.length && el('in-attendees').value.trim()) { S.attendees = parseAttendees(el('in-attendees').value); save(); renderExclude(); }
      }
      if (!S.attendees.length) return say('No golfers loaded yet. Sign in on this laptop, then reload this page.');
      if (!pool().length) return say(S.onlyCheckedIn ? 'Nobody in the hat: no one is checked in yet, or everyone checked in was removed. Check people in, or untick Only draw golfers who are checked in.' : 'Everyone has been removed. Untick some teams.');
      // Opened before anything is awaited, so the browser treats it as a click.
      openProjector();
      // The Hyphos draw never holds up the start. Its entries are fetched now
      // if possible, and again when you reach it if not.
      if (hasContestPrizes() && !S.contest) { try { await loadContest(); } catch {} }
      S.started = true; save(); updateStart(); send('reload');
    });
    el('in-prizes').addEventListener('input', () => {
      if (S.prizes.some((x) => x.special != null)) return;
      S.finale = parsePrizes(el('in-prizes').value); save(); updateStart();
    });
    el('btn-reset').addEventListener('click', () => {
      if (!confirm('Clear the lists and every winner drawn so far?')) return;
      try { localStorage.removeItem(KEY); } catch {}
      location.href = location.pathname + location.search;
    });
    el('btn-export').addEventListener('click', () => {
      const esc = (v) => `"${String(v ?? '').replace(/"/g, '""')}"`;
      const rows = [['order', 'prize', 'sponsor', 'how', 'winner', 'team', 'drawn_at'].join(',')]
        .concat(S.winners.slice().sort((a, b) => a.prizeIndex - b.prizeIndex)
          .map((w) => [w.prizeIndex + 1, w.prize, w.sponsor, w.kind || 'hat', w.name, w.team, w.at].map(esc).join(',')));
      const blob = new Blob([rows.join('\n') + '\n'], { type: 'text/csv' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob);
      a.download = `springs-golf-prize-winners-${new Date().toISOString().slice(0, 10)}.csv`; a.click();
    });

    // two windows --------------------------------------------------------------
    // The control window (this page) stays on the laptop. The projector window
    // (?screen=1) shows only the draw and owns it: it runs the spin and records
    // winners. Control sends commands over a BroadcastChannel; the projector
    // reports what is on screen a few times a second. Both share the saved
    // state through localStorage, so either can be reloaded mid-draw.
    const SCREEN = new URLSearchParams(location.search).has('screen');
    const chan = 'BroadcastChannel' in window ? new BroadcastChannel(`hyphos-prize-draw:${KEY}`) : null;
    const send = (cmd) => chan?.postMessage(typeof cmd === 'string' ? { cmd } : cmd);
    function renderSpecials() {
      const box = el('c-specials'); if (!box) return;
      box.replaceChildren(...S.finale.map((p, i) => {
        const b = document.createElement('button'); b.type = 'button';
        const done = specialDone(i);
        b.textContent = done ? `${shortName(p)} (awarded)` : shortName(p);
        b.disabled = done;
        b.addEventListener('click', () => send({ cmd: 'special', i }));
        return b;
      }));
    }
    function openProjector() {
      const url = `${location.pathname}?screen=1${DEMO ? '&demo=1' : ''}`;
      const w = window.open(url, 'hyphos-projector', 'popup,width=1280,height=720');
      if (!w) {
        const note = el('start-note');
        note.textContent = 'The browser blocked the projector window. Allow pop-ups for hyphos.io, then press Open Projector Window.';
        note.hidden = false;
      }
    }
    let lastSeen = 0;
    // The Pro V1s picker, right on the control screen. The choice is stored
    // where the projector reads it, so Next works straight after.
    function renderPicker(st) {
      const show = st.kind === 'judged' && !st.landed && !st.quote;
      el('c-pick').hidden = !show;
      if (!show) return;
      const best = S.contest?.best || [];
      let pickId = NaN; try { pickId = Number(localStorage.getItem(PICK_KEY)); } catch {}
      const key = JSON.stringify([best.map((b) => b.id), pickId]);
      if (el('c-pick').dataset.key === key) return;
      el('c-pick').dataset.key = key;
      el('c-pick-empty').hidden = best.length > 0;
      el('c-pick-list').replaceChildren(...best.map((b) => {
        const li = document.createElement('li'); if (b.id === pickId) li.className = 'chosen';
        const text = document.createElement('div');
        const wish = document.createElement('div'); wish.className = 'a-wish'; wish.textContent = `“${b.wish}”`;
        const detail = document.createElement('div'); detail.className = 'a-detail'; detail.textContent = b.detail || '';
        const who = document.createElement('div'); who.className = 'a-who'; who.textContent = [b.name, b.company].filter(Boolean).join(' · ');
        text.append(wish, detail, who);
        const btn = document.createElement('button'); btn.type = 'button';
        btn.textContent = b.id === pickId ? 'Chosen' : 'Choose';
        if (b.id === pickId) btn.className = 'primary';
        btn.addEventListener('click', () => {
          try { localStorage.setItem(PICK_KEY, String(b.id)); } catch {}
          el('c-pick').dataset.key = ''; renderPicker(st); send('reload');
        });
        li.append(text, btn); return li;
      }));
    }
    function renderControl(st) {
      el('c-next').textContent = st.nextLabel || 'Next';
      renderPicker(st);
      el('c-kicker').textContent = st.kicker;
      el('c-prize').textContent = st.prize;
      el('c-quote').hidden = !st.quote; el('c-quote').textContent = st.quote || '';
      el('c-reel').textContent = st.reel;
      el('c-reel').classList.toggle('spinning', st.spinning);
      el('c-sub').textContent = st.sub;
      el('c-count').textContent = st.counter;
      el('c-redraw').disabled = !st.canRedraw;
      el('c-specials').querySelectorAll('button').forEach((b, i) => { b.disabled = specialDone(i) || st.spinning; });
      el('c-regular').disabled = st.spinning;
    }
    if (!SCREEN) {
      chan?.addEventListener('message', ({ data }) => {
        if (!data.status) return;
        lastSeen = Date.now(); renderControl(data.status);
      });
      setInterval(() => {
