---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GolfQr from '../../components/GolfQr.astro';

/**
 * The hole screen. Runs all day on a laptop or tablet at the sponsored hole,
 * on a cellular hotspot, unattended between groups.
 *
 * Built for that: it refreshes on a timer, and a failed refresh changes
 * nothing on screen. If the hotspot drops for twenty minutes the board keeps
 * showing the last good data rather than an error, and quietly catches up when
 * signal returns. The only visible sign is a dot in the corner.
 *
 * The QR sits in its own column and never moves. The first groups through
 * arrive at an empty board, so the screen has to work as a poster before it
 * works as a scoreboard: the invitation is always the largest thing on it, and
 * the results grow into the space beside it.
 */
---

<BaseLayout title="Live board"
  noindex minimal>
  <main id="board">
    <div class="col-main">
      <header>
        <p class="kicker">What this room wishes would do itself</p>
        <h1><span id="count">0</span> <small>answers so far</small></h1>
      </header>

      <ol id="bars"></ol>

      <section id="empty">
        <p class="empty-q">“What's the one task at work you wish just did itself?”</p>
        <p class="empty-sub">Answers appear here as they come in.</p>
      </section>

      <section id="latest">
        <p class="kicker">Recently added</p>
        <p id="latest-line">&nbsp;</p>
      </section>
    </div>

    <aside class="col-qr">
      <p class="kicker">Scan To Enter</p>
      <div class="qr-plate"><GolfQr class="qr" /></div>
      <p class="url">hyphosconsulting.com/golf</p>
      <p class="prizes">A dozen Pro V1s and a rangefinder.<br />Both drawn at dinner. Be there to win.</p>
    </aside>

    <div id="dot" title="connection"></div>
  </main>

  <style is:global>
    :root { color-scheme: dark; }
    body { background: #0b1220; overflow: hidden; }
    #board {
      position: fixed; inset: 0; padding: 4vmin 4.5vmin;
      display: grid; grid-template-columns: 1fr minmax(26vw, 30vw); gap: 5vmin;
      align-items: stretch;
    }
    .col-main { display: flex; flex-direction: column; gap: 3vmin; min-width: 0; }
    .kicker {
      font-size: clamp(12px, 1.2vw, 22px); letter-spacing: .24em; text-transform: uppercase;
      color: #76b4ff; margin: 0 0 1.4vmin; font-weight: 600;
    }
    h1 {
      font-family: 'Source Serif 4', Georgia, serif; font-weight: 500; margin: 0;
      font-size: min(5.4vw, 10vh); color: #faf8f4; line-height: 1;
    }
    h1 small { font-size: .32em; color: #9fb0c9; font-family: 'Inter', system-ui, sans-serif; }

    /* The QR column. Fixed width, so nothing about the data can shrink it. */
    .col-qr {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; border-left: 1px solid #1d2a3f; padding-left: 4vmin;
    }
    .qr-plate {
      background: #ffffff; border-radius: 1.4vmin; padding: 1.6vmin;
      line-height: 0; box-shadow: 0 0 6vmin rgba(118, 180, 255, .10);
    }
    .qr { display: block; width: min(22vw, 42vh); height: min(22vw, 42vh); }
    .col-qr .url {
      font-size: min(1.7vw, 3.2vh); color: #faf8f4; font-weight: 600;
      margin: 2.4vmin 0 0; letter-spacing: .01em;
    }
    .col-qr .prizes {
      font-size: min(1.15vw, 2.2vh); color: #9fb0c9; margin: 1.6vmin 0 0; line-height: 1.5;
    }

    #bars { list-style: none; padding: 0; margin: 0; flex: 1; min-height: 0; overflow: hidden;
      display: flex; flex-direction: column; justify-content: center; gap: 1.6vh; }
    #bars li { animation: in .5s ease both; }
    @keyframes in { from { opacity: 0; transform: translateX(-1.5vmin); } to { opacity: 1; transform: none; } }
    .row { display: flex; align-items: baseline; gap: 2vmin; line-height: 1; }
    .n {
      font-family: 'Source Serif 4', Georgia, serif; font-size: min(3vw, 5.4vh);
      color: #76b4ff; min-width: 2.2ch; text-align: right; font-variant-numeric: tabular-nums;
    }
    .label { font-size: min(2vw, 3.6vh); color: #faf8f4; }
    .track { height: 0.9vh; background: #1d2a3f; border-radius: 99px; margin-top: .9vmin; overflow: hidden; }
    .fill { height: 100%; background: #76b4ff; width: 0; transition: width 1s cubic-bezier(.2,.8,.2,1); }

    /* Before anyone has answered. The board should read as an invitation, not
       as a scoreboard that is broken. */
    #empty { display: none; flex: 1; flex-direction: column; justify-content: center; }
    .empty-q {
      font-family: 'Source Serif 4', Georgia, serif; font-size: min(3.2vw, 6vh);
      color: #faf8f4; line-height: 1.25; margin: 0; max-width: 20ch;
    }
    .empty-sub { font-size: min(1.6vw, 3vh); color: #9fb0c9; margin: 2.4vmin 0 0; }

    /* "0 answers so far" in 10vh serif is the wrong first impression for the
       group that happens to arrive first. Drop the tally until there is one. */
    #board.is-empty h1 { display: none; }
    #board.is-empty #bars { display: none; }
    #board.is-empty #empty { display: flex; }
    #board.is-empty #latest { visibility: hidden; }

    #latest { border-top: 1px solid #1d2a3f; padding-top: 2.4vmin; }
    #latest-line {
      font-size: min(1.9vw, 3.6vh); color: #c7d3e4; margin: 0; font-style: italic;
      transition: opacity .38s ease;
    }
    #latest-line.fading { opacity: 0; }
    @media (prefers-reduced-motion: reduce) { #latest-line { transition: none; } }

    #dot {
      position: fixed; right: 1.6vmin; bottom: 1.6vmin; width: 10px; height: 10px;
      border-radius: 99px; background: #2f6d4a; transition: background .4s;
    }
    #dot.stale { background: #7a5a2a; }

    /* Portrait or a narrow tablet: stack, QR on top. It is still the thing
       someone walking past needs to see first. */
    @media (max-aspect-ratio: 1/1) {
      #board { grid-template-columns: 1fr; grid-template-rows: auto 1fr; gap: 3vmin; }
      .col-qr { border-left: 0; border-bottom: 1px solid #1d2a3f; padding: 0 0 3vmin; }
      .qr { width: min(46vw, 30vh); height: min(46vw, 30vh); }
    }
    @media (prefers-reduced-motion: reduce) { #bars li { animation: none; } .fill { transition: none; } }
  </style>

  <script>
    // Rehearsal data. ?demo=1 skips the network entirely, so you can practise
    // the run as often as you like without putting a single fake name near the
    // real entries. Add ?demo=1&empty=1 to see the board as the first group
    // through will find it.
    const DEMO = {
      entries: 34, answered: 31,
      groups: [
        { label: 'writing quotes and invoices at night', count: 9 },
        { label: 'things slipping through the cracks', count: 7 },
        { label: 'chasing money already owed', count: 6 },
        { label: 'rebuilding the schedule every week', count: 5 },
        { label: 'a form for every single job', count: 4 },
      ],
      recent: [
        'quoting, every one is a fresh spreadsheet',
        'chasing the same four guys for payment',
        'rebuilding the week after one cancellation',
        'entering the same job into two systems',
        'the intake form nobody fills in properly',
        'writing invoices after the kids are down',
      ],
      draw: [
        { name: 'Marc Dube', company: 'Dube Excavating' },
        { name: 'Jen Kwan', company: 'Foothills Dental' },
        { name: 'Rob Fenn', company: 'Fenn HVAC' },
        { name: 'Tara Nolan', company: 'Nolan Bakery' },
        { name: 'Amrit Singh', company: 'Singh Landscaping' },
      ],
      best: [
        { name: 'Dale Ross', company: 'Ross Electric', wish: 'invoicing', detail: 'Two full evenings a month I will never get back' },
        { name: 'Sam Doyle', company: 'Doyle Roofing', wish: 'quotes', detail: 'I write them at 10pm after the kids are down' },
      ],
      everyone: ['Marc Dube','Jen Kwan','Rob Fenn','Tara Nolan','Amrit Singh','Dale Ross','Sam Doyle','Pat Miller','Chris Bell','Lena Ortiz','Kyle Brenner','Nina Faust','Owen Reid','Maya Grant','Tom Vance'],
    };
    const params = new URLSearchParams(location.search);
    const DEMO_MODE = params.has('demo');
    const DEMO_EMPTY = params.has('empty');

    const REFRESH_MS = 45000;
    let lastGood = 0;
    let refreshTimer = null;

    const el = (id) => document.getElementById(id);

    // Built as nodes with textContent, never as an HTML string. Group labels
    // are model output derived from whatever golfers typed into the form, so
    // they are untrusted twice over. This screen faces a room.
    function barRow(group, max) {
      const li = document.createElement('li');

      const row = document.createElement('div');
      row.className = 'row';

      const n = document.createElement('span');
      n.className = 'n';
      n.textContent = String(group.count);

      const label = document.createElement('span');
      label.className = 'label';
      label.textContent = String(group.label);

      row.append(n, label);

      const track = document.createElement('div');
      track.className = 'track';
      const fill = document.createElement('div');
      fill.className = 'fill';
      fill.dataset.w = String(Math.round((group.count / max) * 100));
      track.append(fill);

      li.append(row, track);
      return li;
    }

    // The recent-answers line cycles on its own clock, independent of the 45s
    // data refresh. Entries trickle in over five hours, so a line that only
    // moves when someone enters is a line that is motionless most of the day.
    const ROTATE_MS = 7000;
    let recentLines = [];
    let recentIdx = 0;

    function showRecent() {
      const line = el('latest-line');
      if (!recentLines.length) { line.textContent = ' '; return; }
      line.classList.add('fading');
      setTimeout(() => {
        line.textContent = `“${recentLines[recentIdx % recentLines.length]}”`;
        line.classList.remove('fading');
      }, 380);
    }

    function setRecent(lines) {
      // Only restart the cycle when the answers actually changed. A refresh
      // that returns the same list should not yank the line back to the top.
      const same =
        lines.length === recentLines.length && lines.every((l, i) => l === recentLines[i]);
      if (same) return;
      recentLines = lines;
      recentIdx = 0;
      showRecent();
    }

    setInterval(() => {
      if (recentLines.length > 1) { recentIdx++; showRecent(); }
    }, ROTATE_MS);

    function render(data) {
      el('count').textContent = String(data.answered || 0);
      setRecent(data.recent || []);

      const top = (data.groups || []).slice(0, 5);
      // No groups means nothing to rank, whether that is nobody yet or nobody
      // who wrote an answer. Either way the poster is the better screen.
      el('board').classList.toggle('is-empty', top.length === 0);
      if (top.length === 0) return;

      const max = Math.max(1, top[0].count || 1);
      const bars = el('bars');
      bars.replaceChildren(...top.map((g) => barRow(g, max)));
      requestAnimationFrame(() =>
        bars.querySelectorAll('.fill').forEach((f) => (f.style.width = f.dataset.w + '%'))
      );
    }

    async function tick() {
      if (DEMO_MODE) {
        if (DEMO_EMPTY) {
          render({ answered: 0, groups: [] });
          lastGood = Date.now();
          return;
        }
        // Nudge a count each cycle so the refresh behaviour is visible too.
        DEMO.answered += 1;
        DEMO.groups[Math.floor(Math.random() * DEMO.groups.length)].count += 1;
        DEMO.groups.sort((a, b) => b.count - a.count);
        render(DEMO);
        lastGood = Date.now();
        el('dot').classList.remove('stale');
        refreshTimer = setTimeout(tick, 4000);
        return;
      }
      try {
        const res = await fetch('/api/golf/summary?format=board', { cache: 'no-store' });
        if (!res.ok) throw new Error(String(res.status));
        render(await res.json());
        lastGood = Date.now();
      } catch {
        // Hold the last good screen. A hotspot blip should be invisible to the
        // room; only the dot changes.
        if (!lastGood) location.href = '/golf/enter';
      }
      el('dot').classList.toggle('stale', Date.now() - lastGood > REFRESH_MS * 3);
      refreshTimer = setTimeout(tick, REFRESH_MS);
    }

    // Browsers throttle timers in a background tab, so a board that was tabbed
    // away from comes back holding whatever it had when it lost focus. Catch
    // up the moment it is on screen again rather than up to 45s later.
    addEventListener('visibilitychange', () => {
      if (document.visibilityState !== 'visible') return;
      clearTimeout(refreshTimer);
      tick();
    });

    // Start on the poster. If the fetch is slow or the hotspot is still coming
    // up, an empty invitation beats an empty scoreboard.
    el('board').classList.add('is-empty');
    tick();
  </script>
</BaseLayout>
