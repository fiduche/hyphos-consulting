---
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Sign-in for the two screens and the readout. Exists so the password is typed
 * once into a field, never carried in a URL: the dinner screen runs on a
 * projector, and a querystring secret is readable by anyone in the room with a
 * phone. The password is exchanged for a signed HttpOnly cookie the browser
 * sends automatically and no script can read.
 */
---

<BaseLayout title="Sign in"
  noindex minimal>
  <section class="mx-auto max-w-md px-5 pt-24 pb-24">
    <div class="eyebrow mb-3">Hyphos Inc.</div>
    <h1 class="display text-3xl text-ink-900">Tournament screens</h1>
    <p class="mt-3 text-ink-600 leading-relaxed">
      Sign in once on this device and it stays signed in for 30 days.
    </p>

    <form id="f" class="card p-6 mt-8">
      <label class="block text-sm font-semibold text-ink-900 mb-2" for="pw">Password</label>
      <input id="pw" type="password" autocomplete="current-password" required
             class="w-full rounded-lg border border-ink-300 bg-white px-4 py-3.5 text-base outline-none transition focus:border-signal-500 focus:ring-2 focus:ring-signal-100" />
      <p id="err" class="hidden mt-3 text-sm text-warm-600 font-medium"></p>
      <button class="btn-primary w-full justify-center mt-5 py-3.5">Sign in</button>
    </form>

    <div id="links" class="hidden mt-8 space-y-2">
      <p id="signed-in" class="text-sm text-ink-600">Signed in on this device.</p>
      <p><a class="link" href="/golf/board">Hole Board</a>: leave running at the hole</p>
      <p><a class="link" href="/course/?admin=1">Contest Board</a>: remove a bad entry</p>
      <p><a class="link" href="/golf/judge">Choose The Judged Winner</a>: on the dinner laptop, before dinner</p>
      <p><a class="link" href="/golf/prizes">Prize Draw</a>: load contest entries, then plug into the projector</p>
      <p><a class="link" href="/api/golf/summary">Text Readout</a>: the backup</p>
      <p class="pt-4"><button id="sign-out" type="button" class="text-sm text-ink-500 underline underline-offset-4">Sign out on this device</button></p>
    </div>
  </section>

  <script>
    const form = document.getElementById('f') as HTMLFormElement;
    const pw = document.getElementById('pw') as HTMLInputElement;
    const err = document.getElementById('err')!;
    const links = document.getElementById('links')!;
    const note = document.getElementById('signed-in')!;

    // Only return to a tournament page on this site, never to an arbitrary URL.
    const next = new URLSearchParams(location.search).get('next') || '';
    const safeNext = /^\/(golf|course)(\/|$|\?)/.test(next) ? next : '';

    const showSignedIn = (expiresAt?: string | null) => {
      form.classList.add('hidden');
      links.classList.remove('hidden');
      if (expiresAt) {
        const until = new Date(expiresAt).toLocaleDateString('en-CA', { month: 'long', day: 'numeric' });
        note.textContent = `Signed in on this device until ${until}.`;
      }
    };

    // Already signed in? Skip the password box entirely.
    fetch('/api/golf/session', { cache: 'no-store' })
      .then((r) => r.json())
      .then((s) => {
        if (!s.signedIn) return;
        if (safeNext) { location.replace(safeNext); return; }
        showSignedIn(s.expiresAt);
      })
      .catch(() => {});

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.classList.add('hidden');
      const res = await fetch('/api/golf/auth', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ password: pw.value }),
      }).catch(() => null);
      if (res && res.ok) {
        pw.value = '';
        if (safeNext) { location.replace(safeNext); return; }
        const s = await fetch('/api/golf/session', { cache: 'no-store' }).then((r) => r.json()).catch(() => ({}));
        showSignedIn(s.expiresAt);
      } else {
        err.textContent = 'That password is not right.';
        err.classList.remove('hidden');
        pw.select();
      }
    });

    document.getElementById('sign-out')?.addEventListener('click', async () => {
      await fetch('/api/golf/logout', { method: 'POST' }).catch(() => null);
      links.classList.add('hidden');
      form.classList.remove('hidden');
      pw.focus();
    });
  </script>
</BaseLayout>
