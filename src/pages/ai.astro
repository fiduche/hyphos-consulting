---
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * The "10 ways" piece promised on the golf entry form (/golf) and delivered by
 * the follow-up email. Written for a small business owner reading on a phone in
 * the evening: concrete pains first, the reason most AI disappoints second, and
 * one small ask at the end.
 *
 * Deliberately reusable beyond the tournament — it lives at /ai, not /golf/ai.
 */

const ways = [
  {
    title: 'Reading supplier invoices',
    body: 'Pull the amounts, dates and line items off a PDF and code them to the right account, instead of someone retyping them into the accounting system.',
  },
  {
    title: 'Turning a conversation into a quote',
    body: 'Notes from a site visit become a priced estimate in your own format, with your own margins, ready for you to check rather than write.',
  },
  {
    title: 'Meetings that produce actions, not transcripts',
    body: "A wall of text nobody reads is not useful. What's useful is: here are the four things somebody agreed to do, and who owns each one.",
  },
  {
    title: 'Filling out your own paperwork',
    body: 'Contracts, letters, service agreements — the ones where 90% is the same every time and 10% is the part that matters. The 90% should not be manual.',
  },
  {
    title: 'Catching what does not match',
    body: 'Invoices against POs, payments against invoices, hours against schedules. Machines are patient about reconciliation in a way people are not.',
  },
  {
    title: 'Answering the same question for the hundredth time',
    body: '"Where is my order." "What are your hours." "What do I need to bring." A portal that answers accurately from your real data is better than a phone tag loop.',
  },
  {
    title: 'Timesheets that fill themselves in',
    body: 'Most of the information — who was where, on what job, for how long — already exists somewhere else in your business. Asking people to retype it is a choice.',
  },
  {
    title: 'Finding the thing you know you have somewhere',
    body: "Search that understands \"the Henderson quote from last spring\" rather than needing the exact filename you can't remember.",
  },
  {
    title: 'Drafting the follow-up you keep not sending',
    body: "The email to the customer who went quiet. The review request. The seasonal reminder. Drafted and waiting for your approval beats sitting in your head.",
  },
  {
    title: 'Noticing what is about to go wrong',
    body: 'A job trending over budget, a client who has gone quiet, a renewal nobody has picked up. The signals are usually already in your systems, unwatched.',
  },
];
---

<BaseLayout
  title="10 ways small businesses are actually using AI"
  description="A plain-language list of what AI is genuinely useful for in a small business right now — and the reason most of it disappoints."
>
  <section class="mx-auto max-w-2xl px-5 sm:px-8 pt-12 sm:pt-20 pb-8">
    <div class="eyebrow mb-3">Hyphos Consulting</div>
    <h1 class="display text-4xl sm:text-5xl leading-tight text-ink-900">
      10 ways small businesses are actually using AI right now.
    </h1>
    <p class="mt-6 text-lg text-ink-600 leading-relaxed">
      Not the demos. The unglamorous things that quietly take hours out of a week. If one of
      these is the thing you wrote down at the tournament, that's not a coincidence — nearly
      everybody writes down one of these.
    </p>
  </section>

  <section class="mx-auto max-w-2xl px-5 sm:px-8 pb-16">
    <ol class="space-y-8">
      {ways.map((way, i) => (
        <li class="grid grid-cols-[2.25rem_1fr] gap-4">
          <span class="text-sm font-semibold text-signal-600 tabular-nums pt-1">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h2 class="display text-xl text-ink-900">{way.title}</h2>
            <p class="mt-1.5 text-ink-600 leading-relaxed">{way.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="mx-auto max-w-2xl px-5 sm:px-8 pb-16">
    <div class="rule mb-12"></div>

    <div class="eyebrow mb-3">The part that actually matters</div>
    <h2 class="display text-3xl leading-tight text-ink-900">
      Why most of this disappoints the first time.
    </h2>

    <div class="mt-6 space-y-5 text-ink-700 leading-relaxed">
      <p>
        Every business owner who has tried this has had the same experience. The demo is
        astonishing. You bring it into your actual business and it's confidently, fluently
        wrong — because it doesn't know your suppliers, your pricing, your customers, or the
        way you actually do things.
      </p>
      <p>
        <strong class="text-ink-900">That is not a smartness problem. It is an information problem.</strong>
        A model with no access to your business will guess, and it will guess in complete
        sentences, which is what makes it dangerous rather than merely useless.
      </p>
      <p>
        You can't fix that by asking it to be more careful. It's already trying. The fix is
        structural: give it your real information, stored so it can be retrieved and checked —
        and build in the discipline to answer <em>"I don't know"</em> instead of filling the gap.
      </p>
      <p>
        That's the whole job, and it's most of what we do. The interesting part was never the
        chatbot. It's the plumbing underneath it.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-5 sm:px-8 pb-16">
    <div class="rule mb-12"></div>

    <div class="eyebrow mb-3">What we've built</div>
    <div class="space-y-5">
      <div class="card p-6">
        <h3 class="display text-lg text-ink-900">Cornerstone</h3>
        <p class="mt-2 text-ink-600 leading-relaxed">
          The system a funeral group runs its business on — estimates and pricing, vendor
          invoices, document generation, time entry, payroll, accounting sync, and separate
          portals for staff and for families. Around 144 connected tables, because that's what
          it takes for one business to stop retyping itself into six different tools.
        </p>
      </div>
      <div class="card p-6">
        <h3 class="display text-lg text-ink-900">Wander</h3>
        <p class="mt-2 text-ink-600 leading-relaxed">
          A trail and park discovery app, where the useful part is search that understands how
          places actually relate to each other rather than matching keywords.
        </p>
      </div>
      <div class="card p-6">
        <h3 class="display text-lg text-ink-900">Hyphos</h3>
        <p class="mt-2 text-ink-600 leading-relaxed">
          Our own platform, and the deep end of this. It's the retrieval and grounding layer —
          the part that gives an AI agent the correct information and a way to prove where it
          came from. Roughly 2,000 source files of mostly unglamorous plumbing, which is rather
          the point.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-5 sm:px-8 pb-24">
    <div class="rule mb-12"></div>
    <h2 class="display text-2xl text-ink-900">If one of these is your thing</h2>
    <p class="mt-4 text-ink-600 leading-relaxed">
      I'll spend 45 minutes mapping where AI could realistically save you time, and you get a
      one-page write-up at the end — whether or not we end up working together. If the honest
      answer is that you don't need me for it, I'd rather tell you that.
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href="/contact" class="btn-primary">
        Book 45 minutes
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <a href="/work" class="btn-secondary">See the work</a>
    </div>
    <p class="mt-8 text-sm text-ink-500">
      Daniel Newton · Hyphos Consulting · Okotoks &amp; Calgary
    </p>
  </section>
</BaseLayout>
