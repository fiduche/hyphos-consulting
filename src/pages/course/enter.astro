---
import BaseLayout from '../../layouts/BaseLayout.astro';
import './_theme.css';

/**
 * Phone form behind the QR on each contest sign. Pace of play first: the
 * name is remembered after the first entry, so every later contest is the
 * number and one tap. Reached as /c/CTP etc, which logs the scan and lands
 * here with ?c=<contest id>.
 *
 * The roster is deliberately NOT on this page. It is the church's full team
 * sheet, and this page is public: anything shipped here is readable by anyone
 * with the link. The worker matches the typed name against the roster instead
 * and fills in the team, so the list never leaves the server.
 */
---

<BaseLayout title="Post a result" noindex minimal>
  <header class="bar">
    <span class="brand"><img src="/golf/knot.png" alt="" /> hyphos</span>
  </header>

  <main class="wrap">
    <!-- chooser, shown if the contest is missing or unknown -->
    <section id="pick" hidden>
      <p class="kicker">Springs Men's Golf Classic</p>
      <h1>Which contest?</h1>
      <div id="pick-list" class="stack"></div>
    </section>

    <form id="form" hidden autocomplete="off">
      <p class="kicker" id="c-hole"></p>
      <h1 id="c-title"></h1>
      <p class="muted how" id="c-rule"></p>

      <label class="field">
        <span>Your name</span>
        <input id="player" name="player" required autocomplete="name" autocapitalize="words" enterkeyhint="next" placeholder="First and last name" />
      </label>

      <div id="measure" class="field" hidden>
        <span>Distance</span>
        <div class="dist">
          <label><input id="feet" type="number" inputmode="numeric" min="0" max="300" step="1" placeholder="0" /><b>ft</b></label>
          <label><select id="inches">
            <option value="0">0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option>
            <option>6</option><option>7</option><option>8</option><option>9</option><option>10</option><option>11</option>
          </select><b>in</b></label>
        </div>
      </div>

      <div class="hp" aria-hidden="true"><input id="website" type="text" tabindex="-1" autocomplete="off" /></div>

      <button id="submit" type="submit" class="go"></button>
      <p id="err" class="err" role="alert"></p>
    </form>

    <section id="done" hidden>
      <p class="kicker">Posted</p>
      <h1 id="done-title">You're on the board.</h1>
      <p class="muted" id="done-sub"></p>
      <button id="again" type="button" class="ghost">Fix my entry</button>
    </section>
  </main>

  <footer class="foot muted">Honour system, same as the sheet. Powered by <a href="/go/course">Hyphos</a>.</footer>

  <style is:global>
    .wrap { max-width: 520px; margin: 0 auto; padding: 22px 16px 40px; }
    h1 { font-family: 'Source Serif 4', Georgia, serif; font-weight: 500; font-size: 34px; line-height: 1.08; margin: 0 0 8px; }
    .how { margin: 0 0 22px; font-size: 16px; line-height: 1.45; }
    .field { display: flex; flex-direction: column; gap: 8px; margin: 0 0 18px; font-weight: 600; font-size: 15px; }
    input, select { font: 400 20px 'Inter', system-ui, sans-serif; padding: 14px; border: 1.5px solid #cfccc5; border-radius: 10px; background: #fff; color: var(--ink); width: 100%; box-sizing: border-box; }
    input:focus, select:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(176,137,79,.2); }
    .dist { display: grid; grid-template-columns: 1.4fr 1fr; gap: 10px; }
    .dist label { display: flex; align-items: center; gap: 8px; }
    .dist b { font-weight: 500; color: var(--soft); }
    .go { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 18px; border: 0; border-radius: 12px; background: var(--ink); color: #fff; font: 600 19px 'Inter', system-ui, sans-serif; cursor: pointer; text-decoration: none; margin-top: 8px; }
    .go:disabled { opacity: .5; }
    .go.link { background: var(--gold); color: #16181b; }
    .go .dot { width: 9px; height: 9px; border-radius: 50%; background: #d64a3a; }
    .ghost { width: 100%; margin-top: 12px; padding: 14px; background: none; border: 1px solid var(--rule); border-radius: 12px; font: 500 16px 'Inter', system-ui, sans-serif; color: var(--soft); }
    .err { color: var(--bad); min-height: 1.4em; margin: 10px 0 0; font-weight: 500; }
    .stack { display: flex; flex-direction: column; gap: 10px; margin-top: 16px; }
    .stack a { display: block; padding: 16px; border: 1px solid var(--rule); border-radius: 12px; background: #fff; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 18px; }
    .stack a small { display: block; color: var(--soft); font-weight: 400; font-size: 14px; margin-top: 3px; }
    .hp { position: absolute; left: -9999px; }
    .foot { text-align: center; font-size: 13px; padding: 0 16px 28px; }
    .foot a { color: var(--gold-deep); }
  </style>

  <script>
    import { CONTESTS, CONTEST_BY_ID, isMeasured, formatInches } from '../../data/contests.js';

    const $ = (id) => document.getElementById(id);
    const NAME_KEY = 'hyphos-course-name';
    const contest = CONTEST_BY_ID[new URLSearchParams(location.search).get('c') || ''];

    const holeLabel = (c) => (c.hole ? `Hole ${c.hole}` : 'On course') + (c.sponsor ? ` · ${c.sponsor}` : '');

    if (!contest) {
      $('pick').hidden = false;
      $('pick-list').replaceChildren(...CONTESTS.map((c) => {
        const a = document.createElement('a'); a.href = `?c=${c.id}`; a.textContent = c.title;
        const s = document.createElement('small'); s.textContent = holeLabel(c); a.append(s); return a;
      }));
    } else {
      const form = $('form'); form.hidden = false;
      $('c-hole').textContent = holeLabel(contest);
      $('c-title').textContent = contest.title;
      $('c-rule').textContent = contest.rule;
      $('measure').hidden = !isMeasured(contest);
      $('submit').textContent = contest.mode === 'list' ? "I'm in the square" : contest.mode === 'latest' ? 'I moved the marker' : 'Post my distance';

      const player = $('player');
      try { const saved = localStorage.getItem(NAME_KEY); if (saved) player.value = saved; } catch {}
      (player.value ? (isMeasured(contest) ? $('feet') : $('submit')) : player).focus({ preventScroll: true });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        $('err').textContent = '';
        const name = player.value.trim().replace(/\s+/g, ' ');
        if (name.length < 2) { $('err').textContent = 'Pick your name.'; return; }
        const payload = { contest: contest.id, player: name, website: $('website').value };
        if (isMeasured(contest)) {
          payload.feet = Number($('feet').value || 0); payload.inches = Number($('inches').value || 0);
          if (payload.feet * 12 + payload.inches <= 0) { $('err').textContent = 'Enter the distance.'; return; }
        }
        const btn = $('submit'); btn.disabled = true;
        try {
          const res = await fetch('/api/course/entry', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
          const out = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(out.error || 'Could not post. Try again.');
          // The server returns the roster spelling when the name matched, so
          // later contests post under one consistent name.
          if (out.player) payload.player = out.player;
          try { localStorage.setItem(NAME_KEY, payload.player); } catch {}
          showDone();
        } catch (err) {
          $('err').textContent = err.message || 'No signal? Try again in a moment, or write it on the sheet.';
        } finally { btn.disabled = false; }
      });

      $('again').addEventListener('click', () => { $('done').hidden = true; form.hidden = false; });
    }

    // The live board is private now, so the confirmation is written from the
    // contest itself rather than read back from the board.
    function showDone() {
      $('form').hidden = true; $('done').hidden = false;
      $('done-title').textContent = contest.mode === 'list' ? "You're in the draw." : "You're posted.";
      $('done-sub').textContent = contest.mode === 'list' ? 'Drawn at dinner. Be there to win.' : 'Until someone passes you.';
    }
  </script>
</BaseLayout>
