---
/**
 * The /golf entry QR, inline.
 *
 * Inline rather than an <img> on purpose: the hole board runs all day on a
 * cellular hotspot, and a QR that needs its own request is a QR that can fail
 * to appear when signal drops. This one is part of the HTML.
 *
 * Dark modules on white, never inverted. Plenty of scanners refuse a
 * light-on-dark code, and the one place this appears is a screen a stranger
 * has one attempt at from ten feet away.
 *
 * Encodes HTTPS://HYPHOS.IO/GO/BOARD, which counts the scan and then opens at error-correction level H, so it
 * the entry form, so scans from the hole board show up in the scan counts
 * alongside the printed codes. Uppercase packs into a smaller code, and error
 * correction H still reads with a chunk obscured or a camera at an angle.
 */
interface Props { class?: string }
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 37 37"
  shape-rendering="crispEdges"
  role="img"
  aria-label="Scan to enter at hyphos.io/golf"
  xmlns="http://www.w3.org/2000/svg"
>
  <path fill="#ffffff" d="M0 0h37v37H0z" />
