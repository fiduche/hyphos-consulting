---
import Mark from './Mark.astro';

const nav = [
  { label: 'Services', href: '/services' },
  { label: 'Products', href: '/products' },
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
];
---

<header class="sticky top-0 z-40 bg-cream-50/85 backdrop-blur border-b border-ink-200/60">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group" aria-label="Hyphos Consulting — home">
      <Mark size={28} color="#0b1220" accent="#1d6fe0" />
      <span class="display text-lg tracking-tight text-ink-900">Hyphos<span class="text-ink-400 font-light"> Consulting</span></span>
    </a>

    <nav class="hidden md:flex items-center gap-7 text-sm text-ink-700">
      {nav.map(item => (
        <a href={item.href} class="hover:text-ink-900 transition-colors">{item.label}</a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-3">
      {/* Cross-link to the sibling product. Styled distinctly from internal
          nav — a chip with the Hyphos cyan accent and an external-link
          arrow — so it reads as "and we also ship a product, here it is". */}
      <a
        href="https://hyphos.io"
        class="group inline-flex items-center gap-2 pl-3 pr-2.5 py-1.5 rounded-full border border-ink-300/70 bg-cream-50 text-ink-800 hover:border-ink-900 hover:bg-white transition-all text-xs font-medium"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400" style="background-color: #22d3ee;"></span>
        <span>Hyphos<span class="text-ink-500 font-light">.io</span></span>
        <svg class="w-3 h-3 text-ink-500 group-hover:text-ink-900 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <a href="/contact" class="btn-primary text-xs!">Start a conversation</a>
    </div>

    <button id="m-toggle" class="md:hidden p-2 text-ink-700" aria-label="Toggle menu">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="m-menu" class="hidden md:hidden border-t border-ink-200/60 bg-cream-50">
    <div class="px-5 py-4 space-y-1">
      {nav.map(item => (
        <a href={item.href} class="block px-3 py-2.5 text-sm text-ink-800 hover:bg-cream-100 rounded-lg">{item.label}</a>
      ))}
      <a
        href="https://hyphos.io"
        class="flex items-center gap-2 mt-3 px-3 py-2.5 text-sm font-medium text-ink-800 border border-ink-300/70 rounded-full"
      >
        <span class="w-1.5 h-1.5 rounded-full" style="background-color: #22d3ee;"></span>
        Hyphos<span class="text-ink-500 font-light">.io</span>
        <svg class="w-3 h-3 ml-auto text-ink-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <a href="/contact" class="block mt-2 px-3 py-2.5 text-sm font-semibold text-center rounded-full bg-ink-900 text-white">Start a conversation</a>
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById('m-toggle')?.addEventListener('click', () => {
    document.getElementById('m-menu')?.classList.toggle('hidden');
  });
</script>
